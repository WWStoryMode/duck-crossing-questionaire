# Copy these into your host's environment settings (this app does not read .env files itself).

# Access code for /teacher. Required in class — the default "duck" is for local testing only.
TEACHER_CODE=change-me

# Port to listen on. Most hosts set this for you.
PORT=3000

# Optional: the exact URL students should open (used for the QR code).
# Leave unset to use the address the teacher dashboard was opened at
# (or your network address when opened on localhost).
# PUBLIC_URL=https://duck-crossing.example.com/
